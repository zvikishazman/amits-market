generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts            Account[]
  sessions            Session[]
  createdGroups       Group[]       @relation("GroupCreator")
  memberships         Membership[]
  bets                Bet[]
  createdQuestions    Question[]    @relation("QuestionCreator")
  sentSettlements     Settlement[]  @relation("SettlementFrom")
  receivedSettlements Settlement[]  @relation("SettlementTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Group {
  id              String       @id @default(cuid())
  name            String
  inviteCode      String       @unique
  startingBalance Float        @default(1000)
  creatorId       String
  creator         User         @relation("GroupCreator", fields: [creatorId], references: [id])
  members         Membership[]
  questions       Question[]
  settlements     Settlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id      String @id @default(cuid())
  userId  String
  groupId String
  role    String @default("MEMBER")
  balance Float  @default(1000)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([userId, groupId])
}

model Question {
  id               String    @id @default(cuid())
  title            String
  description      String?
  groupId          String
  creatorId        String
  status           String    @default("OPEN")
  resolvedOptionId String?
  betAmount        Float?
  showBetChoices   Boolean  @default(false)

  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User   @relation("QuestionCreator", fields: [creatorId], references: [id])
  options Option[]

  closesAt   DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Option {
  id         String @id @default(cuid())
  text       String
  questionId String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  bets     Bet[]

  createdAt DateTime @default(now())
}

model Bet {
  id       String @id @default(cuid())
  amount   Float
  userId   String
  optionId String
  payout   Float?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  option Option @relation(fields: [optionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Settlement {
  id         String @id @default(cuid())
  groupId    String
  fromUserId String
  toUserId   String
  amount     Float

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("SettlementTo", fields: [toUserId], references: [id])

  createdAt DateTime @default(now())
}
